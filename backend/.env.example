# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/drone_swarm.db

# MAVLink
MAVLINK_BAUDRATE=57600
MAVLINK_UDP_PORT=14550

# 集群
MAX_DRONES=50
HEARTBEAT_TIMEOUT=10
TELEMETRY_INTERVAL=0.5

# ARP
ARP_CACHE_TTL=300
ARP_TABLE_PATH=./data/arp_table.json

# 安全
API_TOKEN=drone-swarm-admin-token
